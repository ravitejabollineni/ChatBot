{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AI": {
    "DefaultProvider": "Ollama",
    "AvailableModels": [
      { "Model": "phi3:mini", "Provider": "Ollama" },
      { "Model": "gpt-5.4-mini", "Provider": "AzureOpenAI", "ContextLimit": 400000 },
      { "Model": "gemini-3.6-flash", "Provider": "GeminiAI", "ContextLimit": 1000000 }
    ],
    "Providers": {
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "ChatModel": "phi3:mini",
        "EmbeddingModel": "nomic-embed-text",
        "NumCtx": 8192
      },
      "AzureOpenAI": {
        "Endpoint": "default",
        "ApiKey": "default",
        "DeploymentName": "gpt-5.4-mini",
        "Models": [
          "gpt-5.4-mini"
        ]
      },
      "GeminiAI": {
        "ApiKey": "default",
        "ChatModel": "gemini-3.6-flash"
      }
    },
    "ContextManagement": {
      "OutputReserveTokens": 1024
    }
  }
}
