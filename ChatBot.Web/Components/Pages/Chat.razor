@page "/"
@page "/chat"
@rendermode InteractiveServer
@implements IDisposable

@using ChatBot.Web.Features.Chat.State
@using ChatBot.Web.Features.Chat.Services
@using ChatBot.Web.Features.Chat.Components

@inject ChatState ChatState
@inject ChatUiService ChatUiService
@inject IDialogService DialogService

<PageTitle>ChatBot</PageTitle>

<MudLayout>
    <MudDrawer Variant="DrawerVariant.Persistent" Open="true" Elevation="0" Width="320px" Class="sidebar-panel">
        <div class="sidebar-panel__header">
            <div>
                <p class="eyebrow">AI Workspace</p>
                <h1>ChatBot</h1>
            </div>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="bi bi-plus-lg"
                       FullWidth="true"
                       OnClick="CreateConversationAsync">
                New Chat
            </MudButton>

            <MudTextField T="string"
                          Placeholder="Search conversations"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="bi bi-search"
                          Immediate="true"
                          Class="sidebar-panel__search" />
        </div>

        <ConversationList />

        <div class="sidebar-panel__footer">
            <MudTooltip Text="Settings">
                <MudIconButton Icon="bi bi-gear" OnClick="OpenSettingsAsync" />
            </MudTooltip>
        </div>
    </MudDrawer>

    <MudAppBar Elevation="0">
        <div class="chat-panel__status">
            <span class="status-dot @(ChatState.IsGenerating ? "status-dot--active" : string.Empty)"></span>
            @(ChatState.IsGenerating ? "Streaming…" : "Ready to help")
        </div>

        <MudSpacer />

        @if (ContextUsage is not null)
        {
            <ContextUsageIndicator Usage="ContextUsage" />
        }

        <MudSelect T="string"
                   Value="ChatState.SelectedModel"
                   ValueChanged="OnModelChangedAsync"
                   Disabled="ChatState.IsGenerating"
                   Dense="true"
                   Class="model-selector">
            @foreach (var model in ChatState.AvailableModels)
            {
                <MudSelectItem T="string" Value="model">@model</MudSelectItem>
            }
        </MudSelect>
    </MudAppBar>

    <MudMainContent Class="chat-panel">
        @if (ChatState.ErrorMessage is not null)
        {
            <div class="alert alert-danger chat-panel__error" role="alert">
                @ChatState.ErrorMessage
            </div>
        }

        <div class="chat-panel__body">
            <ConversationView />
        </div>
    </MudMainContent>
</MudLayout>

@code
{
    protected override async Task OnInitializedAsync()
    {
        ChatState.StateChanged += OnStateChanged;
        await ChatUiService.InitializeAsync();
    }

    private ChatBot.Web.Contracts.Chat.TokenUsageResponse? ContextUsage =>
        ChatState.CurrentConversation?.Messages
            .LastOrDefault(m => m.TokenUsage is not null)?.TokenUsage;

    private async Task CreateConversationAsync()
    {
        await ChatUiService.CreateConversationAsync();
    }

    private async Task OpenSettingsAsync()
    {
        await DialogService.ShowAsync<SettingsDialog>("Settings");
    }

    // ChatState is external state with a private setter (SetModel is the only way to mutate
    // it), so the select is driven via Value/ValueChanged rather than @bind-Value — the same
    // reason ConversationView drives its Cancel button through a plain @onclick instead of
    // two-way binding.
    private Task OnModelChangedAsync(string model)
    {
        if (!string.IsNullOrWhiteSpace(model))
        {
            ChatState.SetModel(model);
        }

        return Task.CompletedTask;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChatState.StateChanged -= OnStateChanged;
    }
}
