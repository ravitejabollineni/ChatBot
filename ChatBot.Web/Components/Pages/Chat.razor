@page "/"
@page "/chat"
@rendermode InteractiveServer
@implements IDisposable

@using ChatBot.Web.Features.Chat.State
@using ChatBot.Web.Features.Chat.Services

@inject ChatState ChatState
@inject ChatUiService ChatUiService

<PageTitle>ChatBot</PageTitle>

<div class="app-shell">
    <aside class="sidebar-panel">
        <div class="sidebar-panel__header">
            <div>
                <p class="eyebrow">AI Workspace</p>
                <h1>ChatBot</h1>
            </div>

            <button class="btn btn-primary sidebar-panel__new-chat"
                    @onclick="CreateConversationAsync">
                <span>+</span> New Chat
            </button>
        </div>

        <ConversationList />
    </aside>

    <section class="chat-panel">
        <header class="chat-panel__header">
            <div class="chat-panel__status">
                <span class="status-dot"></span>
                Ready to help
            </div>

            <div class="model-selector">
                <label for="modelSelect" class="visually-hidden">Model</label>
                <select id="modelSelect"
                        class="form-select"
                        value="@ChatState.SelectedModel"
                        disabled="@ChatState.IsGenerating"
                        @onchange="OnModelChangedAsync">
                    @foreach (var model in ChatState.AvailableModels)
                    {
                        <option value="@model">@model</option>
                    }
                </select>
            </div>
        </header>

        @if (ChatState.ErrorMessage is not null)
        {
            <div class="alert alert-danger chat-panel__error" role="alert">
                @ChatState.ErrorMessage
            </div>
        }

        <div class="chat-panel__body">
            <ConversationView />
        </div>
    </section>
</div>

@code
{    

    protected override async Task OnInitializedAsync()
    {       
        ChatState.StateChanged += OnStateChanged;
        await ChatUiService.InitializeAsync();
    }

    private async Task CreateConversationAsync()
    {
        await ChatUiService.CreateConversationAsync();
    }

    // The <select>'s value is set from ChatState.SelectedModel rather than @bind-value,
    // since ChatState is external state with a private setter (SetModel is the only way
    // to mutate it) — the same reason ConversationView drives its Cancel button through a
    // plain @onclick instead of two-way binding.
    private Task OnModelChangedAsync(ChangeEventArgs e)
    {
        if (e.Value is string model && !string.IsNullOrWhiteSpace(model))
        {
            ChatState.SetModel(model);
        }

        return Task.CompletedTask;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChatState.StateChanged -= OnStateChanged;
    }
}
