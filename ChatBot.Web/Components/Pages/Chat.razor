@page "/"
@page "/chat"
@rendermode InteractiveServer
@implements IDisposable

@using ChatBot.Web.Features.Chat.State
@using ChatBot.Web.Features.Chat.Services

@inject ChatState ChatState
@inject ChatUiService ChatUiService

<PageTitle>ChatBot</PageTitle>

<div class="app-shell">
    <aside class="sidebar-panel">
        <div class="sidebar-panel__header">
            <div>
                <p class="eyebrow">AI Workspace</p>
                <h1>ChatBot</h1>
            </div>

            <button class="btn btn-primary sidebar-panel__new-chat"
                    @onclick="CreateConversationAsync">
                <span>+</span> New Chat
            </button>
        </div>

        <ConversationList />
    </aside>

    <section class="chat-panel">
        <header class="chat-panel__header">
            <div>
                <p class="eyebrow">Model</p>
                <div class="model-selector">
                    <select class="form-select form-select-sm"
                            @bind="selectedModel"
                            @bind:after="OnModelChanged">
                        <option value="gpt-4.1-mini">GPT-4.1 Mini</option>
                        <option value="gpt-4.1">GPT-4.1</option>
                        <option value="gpt-4o">GPT-4o</option>
                    </select>
                </div>
            </div>

            <div class="chat-panel__status">
                <span class="status-dot"></span>
                Ready to help
            </div>
        </header>

        @if (ChatState.ErrorMessage is not null)
        {
            <div class="alert alert-danger chat-panel__error" role="alert">
                @ChatState.ErrorMessage
            </div>
        }

        <div class="chat-panel__body">
            <ConversationView />
        </div>
    </section>
</div>

@code
{
    private string selectedModel = "gpt-4.1-mini";

    protected override async Task OnInitializedAsync()
    {
        selectedModel = ChatState.SelectedModel;
        ChatState.StateChanged += OnStateChanged;
        await ChatUiService.InitializeAsync();
    }

    private async Task CreateConversationAsync()
    {
        await ChatUiService.CreateConversationAsync();
    }

    private void OnModelChanged()
    {
        ChatState.SetModel(selectedModel);
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChatState.StateChanged -= OnStateChanged;
    }
}
