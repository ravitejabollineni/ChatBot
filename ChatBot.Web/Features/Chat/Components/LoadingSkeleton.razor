<div class="loading-skeleton">
    @for (var i = 0; i < Count; i++)
    {
        <div class="loading-skeleton__row">
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="70%" Height="18px" />
            <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" Height="14px" />
        </div>
    }
</div>

@code {
    [Parameter]
    public int Count { get; set; } = 3;
}
