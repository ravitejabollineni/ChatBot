@using ChatBot.Web.Features.Chat.Contracts.Conversation

<button class="conversation-item @(IsActive ? "conversation-item--active" : string.Empty)"
        @onclick="() => OnSelect.InvokeAsync(Conversation.ConversationId)">
    <span class="conversation-item__title">@Title</span>
    @if (!string.IsNullOrEmpty(Preview))
    {
        <span class="conversation-item__meta">@Preview</span>
    }
</button>

@code {
    [Parameter, EditorRequired]
    public ConversationSummaryResponse Conversation { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Title { get; set; } = null!;

    [Parameter]
    public string? Preview { get; set; }

    [Parameter]
    public bool IsActive { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnSelect { get; set; }
}
