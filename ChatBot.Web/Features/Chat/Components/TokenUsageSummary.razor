@using System.Globalization
@using ChatBot.Web.Contracts.Chat

<div class="token-usage">
    <div class="token-usage__stats">
        <span class="token-usage__stat">Input: @Usage.InputTokenCount.ToString("N0")</span>
        <span class="token-usage__stat">Output: @Usage.OutputTokenCount.ToString("N0")</span>
        <span class="token-usage__stat">Remaining: @Usage.RemainingTokenBudget.ToString("N0")</span>
        <span class="token-usage__stat token-usage__stat--percentage">@FormattedPercentage% used</span>
    </div>
    <div class="token-usage__bar"
         role="progressbar"
         aria-label="Context window used"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuenow="@FormattedPercentage">
        <div class="token-usage__bar-fill @(BarSeverityClass)"
             style="width:@(ClampedPercentage.ToString(CultureInfo.InvariantCulture))%"></div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TokenUsageResponse Usage { get; set; } = null!;

    private double ClampedPercentage => Math.Clamp(Usage.PercentageUsed, 0, 100);

    private string FormattedPercentage => Usage.PercentageUsed.ToString("0.##", CultureInfo.InvariantCulture);

    private string BarSeverityClass => ClampedPercentage switch
    {
        >= 90 => "token-usage__bar-fill--critical",
        >= 70 => "token-usage__bar-fill--warning",
        _ => "token-usage__bar-fill--ok"
    };
}
