@using ChatBot.Web.Features.Chat.Contracts.Conversation
@using ChatBot.Web.Features.Chat.Rendering
@using ChatBot.Web.Features.Chat.Services
@using ChatBot.Web.Features.Chat.State
@using Markdig
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject ChatState ChatState
@inject ChatUiService ChatUiService

<div class="message-bubble @(IsUser ? "message-bubble--user" : "message-bubble--assistant")">
    <div class="message-bubble__role">@(IsUser ? "You" : "Assistant")</div>
    <div class="message-bubble__content" @ref="contentRef">
        @if (IsUser)
        {
            @Message.Content
        }
        else
        {
            @RenderMarkdown(Message.Content)
        }
    </div>

    @if (!IsUser && Message.IsPartial)
    {
        <div class="message-bubble__partial-notice">
            <i class="bi bi-exclamation-triangle"></i> Response was interrupted
        </div>
    }

    @if (!IsUser && Message.TokenUsage is not null)
    {
        <TokenUsage Usage="Message.TokenUsage" />
    }

    @if (ShowActions)
    {
        <div class="message-actions">
            <button type="button" class="message-actions__btn" title="Copy response" aria-label="Copy response"
                    @ref="copyButtonRef" @onclick="CopyResponseAsync">
                <i class="bi bi-clipboard"></i>
            </button>

            @if (IsLatestAssistantMessage)
            {
                <button type="button" class="message-actions__btn" title="Regenerate response" aria-label="Regenerate response"
                        @onclick="RegenerateAsync">
                    <i class="bi bi-arrow-repeat"></i>
                </button>
            }

            <button type="button"
                    class="message-actions__btn @(Feedback == true ? "message-actions__btn--active" : "")"
                    title="Good response" aria-label="Good response"
                    @onclick="() => ChatState.SetMessageFeedback(Message.MessageId, true)">
                <i class="bi bi-hand-thumbs-up"></i>
            </button>

            <button type="button"
                    class="message-actions__btn @(Feedback == false ? "message-actions__btn--active" : "")"
                    title="Bad response" aria-label="Bad response"
                    @onclick="() => ChatState.SetMessageFeedback(Message.MessageId, false)">
                <i class="bi bi-hand-thumbs-down"></i>
            </button>
        </div>
    }
</div>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UseHighlightedCodeBlocks()
        .DisableHtml()
        .Build();

    private ElementReference contentRef;
    private ElementReference copyButtonRef;

    [Parameter, EditorRequired]
    public MessageResponse Message { get; set; } = null!;

    [Parameter]
    public bool IsLatestAssistantMessage { get; set; }

    private bool IsUser => string.Equals(Message.Role, "user", StringComparison.OrdinalIgnoreCase);

    // Excludes the Guid.Empty-sentinel pending user-message case (see ChatState.AppendPendingUserMessage).
    private bool ShowActions => !IsUser && Message.MessageId != Guid.Empty;

    private bool? Feedback => ChatState.GetMessageFeedback(Message.MessageId);

    private async Task CopyResponseAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("chatBot.copyText", copyButtonRef, Message.Content);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone; nothing to copy to for a client that's no longer there.
        }
    }

    private Task RegenerateAsync() => ChatUiService.RegenerateLastResponseAsync(ChatState.SelectedModel);

    private static MarkupString RenderMarkdown(string content) =>
        new(Markdown.ToHtml(content, MarkdownPipeline));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || IsUser)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("chatBot.highlightCodeBlocks", contentRef);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone right after first render; nothing to highlight for a component
            // that won't render again.
        }
    }
}
