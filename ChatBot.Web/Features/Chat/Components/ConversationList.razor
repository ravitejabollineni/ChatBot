@implements IDisposable

@using ChatBot.Web.Features.Chat.Contracts.Conversation
@using ChatBot.Web.Features.Chat.State
@using ChatBot.Web.Features.Chat.Services

@inject ChatState ChatState
@inject ChatUiService ChatUiService

<div class="conversation-list">
    @if (ChatState.IsLoadingConversations)
    {
        <LoadingSkeleton />
    }
    else if (ChatState.Conversations.Count == 0)
    {
        @* Nothing to show — matches ChatGPT's sidebar, which just leaves this area empty
           rather than surfacing an explicit "no conversations" card. *@
    }
    else
    {
        @foreach (var group in GetGroupedConversations())
        {
            <div class="conversation-group">
                <div class="conversation-group__label">@group.Label</div>
                @foreach (var conversation in group.Conversations)
                {
                    <ConversationItem Conversation="conversation"
                                       Title="@conversation.Title"
                                       Preview="@GetPreview(conversation)"
                                       IsActive="ChatState.SelectedConversationId == conversation.ConversationId"
                                       OnSelect="SelectConversationAsync" />
                }
            </div>
        }
    }
</div>

@code
{
    private sealed record ConversationGroup(string Label, IReadOnlyList<ConversationSummaryResponse> Conversations);

    protected override void OnInitialized()
    {
        ChatState.StateChanged += OnStateChanged;
    }

    private IEnumerable<ConversationGroup> GetGroupedConversations()
    {
        var today = DateTimeOffset.Now.Date;
        var yesterday = today.AddDays(-1);
        var pastWeek = today.AddDays(-7);

        var buckets = new Dictionary<string, List<ConversationSummaryResponse>>();
        var order = new List<string>();

        foreach (var conversation in ChatState.Conversations.OrderByDescending(c => c.LastUpdatedAt))
        {
            var date = conversation.LastUpdatedAt.ToLocalTime().Date;

            var label = date == today
                ? "Today"
                : date == yesterday
                    ? "Yesterday"
                    : date > pastWeek
                        ? "Previous 7 Days"
                        : date.Year == today.Year
                            ? date.ToString("MMMM")
                            : "Older";

            if (!buckets.TryGetValue(label, out var items))
            {
                items = [];
                buckets[label] = items;
                order.Add(label);
            }

            items.Add(conversation);
        }

        return order.Select(label => new ConversationGroup(label, buckets[label]));
    }

    // "Generating response…" only stands in for a preview that doesn't exist yet (a
    // conversation's first turn). Once a real preview exists, it stays on screen through
    // every later turn's generation and is only replaced once that turn's own preview lands.
    // Otherwise, with nothing to show yet, the item renders with just its title — no
    // placeholder "No messages yet" line underneath.
    private string? GetPreview(ConversationSummaryResponse conversation) =>
        ChatState.IsGenerating
            && ChatState.SelectedConversationId == conversation.ConversationId
            && string.IsNullOrEmpty(conversation.Preview)
            ? "Generating response…"
            : string.IsNullOrEmpty(conversation.Preview) ? null : conversation.Preview;

    private async Task SelectConversationAsync(Guid conversationId)
    {
        await ChatUiService.LoadConversationAsync(conversationId);
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChatState.StateChanged -= OnStateChanged;
    }
}
